# iOS standalone and embedded AUv3 helpers; use the Xcode generator.
# Set PAMPLEJUCE_IOS_DEPLOYMENT_TARGET before including PamplejuceMacOS.

# Keep the iOS deployment target out of JUCE's host juceaide build; preserve caller scope.
macro(pamplejuce_add_juce JUCE_DIRECTORY)
    if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
        # Preserve any caller override of the cached deployment target.
        set(_pamp_deployment_target "${CMAKE_OSX_DEPLOYMENT_TARGET}")
        set(CMAKE_OSX_DEPLOYMENT_TARGET "")
        add_subdirectory(${JUCE_DIRECTORY} ${ARGN})
        if (_pamp_deployment_target STREQUAL "$CACHE{CMAKE_OSX_DEPLOYMENT_TARGET}")
            unset(CMAKE_OSX_DEPLOYMENT_TARGET)
        else ()
            set(CMAKE_OSX_DEPLOYMENT_TARGET "${_pamp_deployment_target}")
        endif ()
        unset(_pamp_deployment_target)
    else ()
        add_subdirectory(${JUCE_DIRECTORY} ${ARGN})
    endif ()
endmacro()

# Append iOS juce_add_plugin options to OUT_VAR; leave it unchanged on other platforms.
# Optional: APP_GROUP_ID, BLUETOOTH_TEXT, IPHONE (default: iPad only), PLIST_TO_MERGE.
# EXEMPT_ENCRYPTION_ONLY opts into the export compliance declaration; supply all extra plist content here.
function(pamplejuce_ios_plugin_options OUT_VAR)
    cmake_parse_arguments(PAMP_IOS "IPHONE;EXEMPT_ENCRYPTION_ONLY" "APP_GROUP_ID;BLUETOOTH_TEXT;PLIST_TO_MERGE" "" ${ARGN})

    if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
        return()
    endif ()

    set(options
        BACKGROUND_AUDIO_ENABLED TRUE
        FILE_SHARING_ENABLED TRUE
        DOCUMENT_BROWSER_ENABLED TRUE
        STATUS_BAR_HIDDEN TRUE
        # iPad multitasking requires all orientations.
        IPAD_SCREEN_ORIENTATIONS UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
            UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight)

    # JUCE uses only the last PLIST_TO_MERGE value.
    set(plist "")
    if (PAMP_IOS_EXEMPT_ENCRYPTION_ONLY)
        string(APPEND plist "<key>ITSAppUsesNonExemptEncryption</key><false/>")
    endif ()
    if (PAMP_IOS_PLIST_TO_MERGE)
        # Preserve nested dictionaries by extracting between the outermost dict tags.
        string(FIND "${PAMP_IOS_PLIST_TO_MERGE}" "<dict>" start)
        string(FIND "${PAMP_IOS_PLIST_TO_MERGE}" "</dict>" end REVERSE)
        math(EXPR start "${start} + 6")
        math(EXPR length "${end} - ${start}")
        string(SUBSTRING "${PAMP_IOS_PLIST_TO_MERGE}" ${start} ${length} extra)
        string(APPEND plist "${extra}")
    endif ()
    if (plist)
        list(APPEND options PLIST_TO_MERGE "<plist><dict>${plist}</dict></plist>")
    endif ()

    if (PAMP_IOS_IPHONE)
        list(APPEND options TARGETED_DEVICE_FAMILY "1,2")
    else ()
        list(APPEND options TARGETED_DEVICE_FAMILY 2)
    endif ()

    if (PAMP_IOS_APP_GROUP_ID)
        list(APPEND options APP_GROUPS_ENABLED TRUE APP_GROUP_IDS "${PAMP_IOS_APP_GROUP_ID}")
    endif ()

    if (PAMP_IOS_BLUETOOTH_TEXT)
        list(APPEND options BLUETOOTH_PERMISSION_TEXT "${PAMP_IOS_BLUETOOTH_TEXT}")
    endif ()

    set(${OUT_VAR} ${${OUT_VAR}} ${options} PARENT_SCOPE)
endfunction()

# Call after juce_add_plugin; the AUv3 bundle ID must be prefixed by the app's bundle ID.
# Update both Xcode and the plist generated by juceaide.
function(pamplejuce_ios_auv3_bundle_id PLUGIN_TARGET AUV3_BUNDLE_ID)
    if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS" OR NOT TARGET "${PLUGIN_TARGET}_AUv3")
        return()
    endif ()

    set_target_properties("${PLUGIN_TARGET}_AUv3" PROPERTIES XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${AUV3_BUNDLE_ID}")

    get_target_property(plist "${PLUGIN_TARGET}_AUv3" MACOSX_BUNDLE_INFO_PLIST)
    file(READ "${plist}" content)
    string(REGEX REPLACE "(<key>CFBundleIdentifier</key>[ \t\r\n]*<string>)[^<]*" "\\1${AUV3_BUNDLE_ID}" content "${content}")
    if (NOT content MATCHES "<string>${AUV3_BUNDLE_ID}</string>")
        message(FATAL_ERROR "Couldn't set the AUv3 bundle ID in ${plist}, has juceaide's plist format changed?")
    endif ()
    file(WRITE "${plist}" "${content}")
endfunction()

# Call after juce_add_plugin to retain symbols for archive dSYMs, including shared code.
function(pamplejuce_ios_archive_settings PLUGIN_TARGET)
    if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
        return()
    endif ()

    set_target_properties("${PLUGIN_TARGET}" PROPERTIES
        XCODE_ATTRIBUTE_DEBUG_INFORMATION_FORMAT "dwarf-with-dsym"
        XCODE_ATTRIBUTE_GCC_GENERATE_DEBUGGING_SYMBOLS "YES")

    foreach (target "${PLUGIN_TARGET}_Standalone" "${PLUGIN_TARGET}_AUv3")
        if (TARGET "${target}")
            set_target_properties("${target}" PROPERTIES
                XCODE_ATTRIBUTE_DEBUG_INFORMATION_FORMAT "dwarf-with-dsym"
                XCODE_ATTRIBUTE_DWARF_DSYM_FILE_SHOULD_ACCOMPANY_PRODUCT "YES"
                XCODE_ATTRIBUTE_GCC_GENERATE_DEBUGGING_SYMBOLS "YES"
                # Defer stripping until dSYMs have been generated.
                XCODE_ATTRIBUTE_DEPLOYMENT_POSTPROCESSING "NO"
                XCODE_ATTRIBUTE_COPY_PHASE_STRIP "NO"
                XCODE_ATTRIBUTE_STRIP_INSTALLED_PRODUCT "NO")
        endif ()
    endforeach ()
endfunction()

# Use a separate Swift library to avoid JUCE's C++ warning flags.
# Link as C++ with an SDK-relative Swift runtime path to support both device and simulator.
function(pamplejuce_ios_link_swift PLUGIN_TARGET SWIFT_LIBRARY)
    target_link_libraries("${PLUGIN_TARGET}" PRIVATE "${SWIFT_LIBRARY}")

    if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
        return()
    endif ()

    foreach (target "${PLUGIN_TARGET}_Standalone" "${PLUGIN_TARGET}_AUv3")
        if (TARGET "${target}")
            set(paths "$(SDKROOT)/usr/lib/swift")
            get_target_property(existing "${target}" XCODE_ATTRIBUTE_LIBRARY_SEARCH_PATHS)
            if (existing)
                string(APPEND paths " ${existing}")
            endif ()
            set_target_properties("${target}" PROPERTIES
                LINKER_LANGUAGE CXX
                XCODE_ATTRIBUTE_LIBRARY_SEARCH_PATHS "${paths}")
        endif ()
    endforeach ()
endfunction()
